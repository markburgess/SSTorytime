#!/bin/sh
#
# Make a certificate (self-signed, localhost SAN via localhost.conf)

dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
cnf="$dir/localhost.conf"

if [ -f "cert.pem" ]; then
	echo The certificate files exist
	exit 0
fi

if [ ! -f "$cnf" ]; then
	echo "missing config: $cnf" >&2
	exit 1
fi

openssl req -x509 -newkey rsa:4096 -keyout key.pem -out cert.pem -days 365 -nodes -config "$cnf"
